<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkyReserve</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary": "#ffffff",
                        "on-surface-variant": "#424752",
                        "on-surface": "#0b1c30",
                        "error": "#ba1a1a",
                        "surface-container": "#e5eeff",
                        "outline": "#727784",
                        "on-secondary-fixed-variant": "#414750",
                        "on-tertiary-container": "#acd4ff",
                        "surface-bright": "#f8f9ff",
                        "inverse-on-surface": "#eaf1ff",
                        "on-primary-container": "#bbd0ff",
                        "on-primary-fixed-variant": "#004491",
                        "inverse-surface": "#213145",
                        "on-error": "#ffffff",
                        "secondary-container": "#dde3ee",
                        "surface-variant": "#d3e4fe",
                        "on-secondary-fixed": "#161c24",
                        "background": "#f8f9ff",
                        "surface-tint": "#115cb9",
                        "inverse-primary": "#acc7ff",
                        "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff",
                        "tertiary-container": "#005d94",
                        "tertiary-fixed": "#cfe5ff",
                        "on-background": "#0b1c30",
                        "surface-container-highest": "#d3e4fe",
                        "on-tertiary": "#ffffff",
                        "on-primary-fixed": "#001a40",
                        "on-secondary": "#ffffff",
                        "surface-container-low": "#eff4ff",
                        "surface": "#f8f9ff",
                        "error-container": "#ffdad6",
                        "primary-container": "#0056b3",
                        "on-tertiary-fixed-variant": "#004a77",
                        "secondary": "#585f68",
                        "surface-dim": "#cbdbf5",
                        "secondary-fixed": "#dde3ee",
                        "outline-variant": "#c2c6d4",
                        "tertiary": "#00456f",
                        "surface-container-lowest": "#ffffff",
                        "tertiary-fixed-dim": "#98cbff",
                        "primary": "#003f87",
                        "on-tertiary-fixed": "#001d33",
                        "on-secondary-container": "#5e656e",
                        "surface-container-high": "#dce9ff",
                        "on-error-container": "#93000a",
                        "secondary-fixed-dim": "#c1c7d1"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "label-md": ["Inter"],
                        "display": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "body-sm": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "label-md": ["12px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "display": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-md": ["24px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-sm": ["14px", { "lineHeight": "1.5", "fontWeight": "400" }]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        @@keyframes plane-fly {
            0% { transform: translate(-100%, 50%) rotate(5deg); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translate(200%, -50%) rotate(5deg); opacity: 0; }
        }
        .animate-plane {
            animation: plane-fly 15s linear infinite;
        }
    </style>
</head>
<body class="bg-background text-on-surface font-body-md overflow-x-hidden min-h-screen flex flex-col">
    <!-- TopNavBar -->
    <nav class="bg-white/90 backdrop-blur-md fixed top-0 w-full z-50 border-b border-slate-200 shadow-sm font-['Inter'] antialiased">
        <div class="max-w-[1280px] mx-auto px-8 flex justify-between items-center h-16">
            <div class="flex items-center gap-12">
                <a class="text-2xl font-bold tracking-tight text-blue-700" asp-area="" asp-controller="Home" asp-action="Index">SkyReserve</a>
                <div class="hidden md:flex items-center gap-8">
                    <a class="text-slate-600 hover:text-blue-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "text-blue-700 font-semibold border-b-2 border-blue-700 pb-1" : "")" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="text-slate-600 hover:text-blue-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Flights" ? "text-blue-700 font-semibold border-b-2 border-blue-700 pb-1" : "")" asp-controller="Flights" asp-action="Index">Flights</a>
                    <a class="text-slate-600 hover:text-blue-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" ? "text-blue-700 font-semibold border-b-2 border-blue-700 pb-1" : "")" asp-controller="Bookings" asp-action="Index">Bookings</a>
                    <a class="text-slate-600 hover:text-blue-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Passengers" ? "text-blue-700 font-semibold border-b-2 border-blue-700 pb-1" : "")" asp-controller="Passengers" asp-action="Index">Passengers</a>
                </div>
            </div>
            <button class="bg-primary text-on-primary px-6 py-2 rounded-lg font-label-md active:scale-95 transition-transform">Sign In</button>
        </div>
    </nav>

    <main role="main" class="flex-grow pt-16">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-slate-50 border-t border-slate-200 w-full py-12 mt-auto text-sm font-['Inter'] text-slate-500">
        <div class="max-w-[1280px] mx-auto px-8">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-8">
                <span class="font-bold text-slate-900 text-xl">SkyReserve</span>
                <div class="flex gap-8">
                    <a class="text-slate-500 hover:text-blue-600 transition-colors opacity-80 hover:opacity-100" href="#">Privacy Policy</a>
                    <a class="text-slate-500 hover:text-blue-600 transition-colors opacity-80 hover:opacity-100" href="#">Terms of Service</a>
                    <a class="text-slate-500 hover:text-blue-600 transition-colors opacity-80 hover:opacity-100" href="#">Support</a>
                    <a class="text-slate-500 hover:text-blue-600 transition-colors opacity-80 hover:opacity-100" href="#">Contact</a>
                </div>
            </div>
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-8 border-t border-slate-200">
                <p>© 2026 SkyReserve. All rights reserved.</p>
                <div class="flex gap-4">
                    <span class="material-symbols-outlined text-slate-400 cursor-pointer hover:text-primary transition-colors">language</span>
                    <span class="material-symbols-outlined text-slate-400 cursor-pointer hover:text-primary transition-colors">share</span>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
