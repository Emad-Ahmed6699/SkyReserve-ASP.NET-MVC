<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkyReserve</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary": "#ffffff",
                        "on-surface-variant": "#424752",
                        "on-surface": "#0b1c30",
                        "error": "#ba1a1a",
                        "surface-container": "#e5eeff",
                        "outline": "#727784",
                        "on-secondary-fixed-variant": "#414750",
                        "on-tertiary-container": "#acd4ff",
                        "surface-bright": "#f8f9ff",
                        "inverse-on-surface": "#eaf1ff",
                        "on-primary-container": "#bbd0ff",
                        "on-primary-fixed-variant": "#004491",
                        "inverse-surface": "#213145",
                        "on-error": "#ffffff",
                        "secondary-container": "#dde3ee",
                        "surface-variant": "#d3e4fe",
                        "on-secondary-fixed": "#161c24",
                        "background": "#f8f9ff",
                        "surface-tint": "#115cb9",
                        "inverse-primary": "#acc7ff",
                        "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff",
                        "tertiary-container": "#005d94",
                        "tertiary-fixed": "#cfe5ff",
                        "on-background": "#0b1c30",
                        "surface-container-highest": "#d3e4fe",
                        "on-tertiary": "#ffffff",
                        "on-primary-fixed": "#001a40",
                        "on-secondary": "#ffffff",
                        "surface-container-low": "#eff4ff",
                        "surface": "#f8f9ff",
                        "error-container": "#ffdad6",
                        "primary-container": "#0056b3",
                        "on-tertiary-fixed-variant": "#004a77",
                        "secondary": "#585f68",
                        "surface-dim": "#cbdbf5",
                        "secondary-fixed": "#dde3ee",
                        "outline-variant": "#c2c6d4",
                        "tertiary": "#00456f",
                        "surface-container-lowest": "#ffffff",
                        "tertiary-fixed-dim": "#98cbff",
                        "primary": "#003f87",
                        "on-tertiary-fixed": "#001d33",
                        "on-secondary-container": "#5e656e",
                        "surface-container-high": "#dce9ff",
                        "on-error-container": "#93000a",
                        "secondary-fixed-dim": "#c1c7d1"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "1rem",
                        "2xl": "1.5rem",
                        "3xl": "2rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "display": ["Inter", "sans-serif"],
                        "body": ["Inter", "sans-serif"]
                    },
                    "fontSize": {
                        "display": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline": ["32px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
                    }
                },
            },
        }
    </script>
    <style>
        @@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        /* Premium Components */
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.07);
            border-radius: 2rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 12px 48px rgba(31, 38, 135, 0.12);
            transform: translateY(-4px);
        }

        .btn-premium {
            background: linear-gradient(135deg, #0056b3 0%, #003f87 100%);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 1rem;
            font-weight: 600;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(0, 63, 135, 0.2);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-premium:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 63, 135, 0.3);
            opacity: 0.95;
        }

        .btn-premium:active {
            transform: scale(0.98);
        }

        .input-premium {
            background: rgba(248, 249, 255, 0.8);
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            padding: 0.75rem 1rem;
            transition: all 0.2s ease;
            width: 100%;
        }

        .input-premium:focus {
            outline: none;
            border-color: #0056b3;
            background: white;
            box-shadow: 0 0 0 4px rgba(0, 86, 179, 0.1);
        }

        .badge-premium {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        @@keyframes plane-fly {
            0% { transform: translate(-100%, 50%) rotate(5deg); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translate(200%, -50%) rotate(5deg); opacity: 0; }
        }

        .animate-plane {
            animation: plane-fly 15s linear infinite;
        }
    </style>
</head>
<body class="bg-background text-on-surface font-body overflow-x-hidden min-h-screen flex flex-col">
    <!-- TopNavBar -->
    <nav class="bg-white/90 backdrop-blur-md fixed top-0 w-full z-50 border-b border-slate-200 shadow-sm antialiased">
        <div class="max-w-[1280px] mx-auto px-8 flex justify-between items-center h-16">
            <div class="flex items-center gap-12">
                <a class="text-2xl font-bold tracking-tight text-primary flex items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="material-symbols-outlined text-primary text-3xl">flight_takeoff</span>
                    SkyReserve
                </a>
                <div class="hidden md:flex items-center gap-8">
                    <a class="text-slate-600 hover:text-primary transition-colors py-2 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "text-primary font-semibold border-b-2 border-primary" : "")" asp-controller="Home" asp-action="Index">Home</a>
                    
                    @if (Context.Session.GetString("UserName") != null)
                    {
                        <a class="text-slate-600 hover:text-primary transition-colors py-2 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Flights" ? "text-primary font-semibold border-b-2 border-primary" : "")" asp-controller="Flights" asp-action="Index">Flights</a>
                        <a class="text-slate-600 hover:text-primary transition-colors py-2 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" ? "text-primary font-semibold border-b-2 border-primary" : "")" asp-controller="Bookings" asp-action="Index">Bookings</a>
                        <a class="text-slate-600 hover:text-primary transition-colors py-2 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Passengers" ? "text-primary font-semibold border-b-2 border-primary" : "")" asp-controller="Passengers" asp-action="Index">Passengers</a>
                    }
                </div>
            </div>

            <div class="flex items-center gap-4">
                @if (Context.Session.GetString("UserName") != null)
                {
                    <span class="text-slate-600 font-medium hidden lg:inline">Welcome, @Context.Session.GetString("UserName")</span>
                    <a asp-controller="Account" asp-action="Logout" class="btn-premium !bg-error !shadow-error/20">
                        <span class="material-symbols-outlined">logout</span> Logout
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-slate-600 hover:text-primary font-semibold transition-colors">Login</a>
                    <a asp-controller="Account" asp-action="SignUp" class="btn-premium">
                        <span class="material-symbols-outlined">person_add</span> Sign Up
                    </a>
                }
            </div>
        </div>
    </nav>

    <main role="main" class="flex-grow pt-16">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-slate-50 border-t border-slate-200 w-full py-12 mt-auto text-sm text-slate-500">
        <div class="max-w-[1280px] mx-auto px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
                <div class="col-span-1 md:col-span-2">
                    <span class="font-bold text-slate-900 text-2xl flex items-center gap-2 mb-4">
                        <span class="material-symbols-outlined text-primary text-3xl">flight_takeoff</span>
                        SkyReserve
                    </span>
                    <p class="max-w-sm text-slate-500 text-base leading-relaxed">
                        Redefining the sky with premium booking experiences. Travel with clarity, comfort, and unmatched efficiency.
                    </p>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 mb-4 uppercase tracking-wider text-xs">Quick Links</h4>
                    <ul class="space-y-2">
                        <li><a class="hover:text-primary transition-colors" asp-controller="Flights" asp-action="Index">Find Flights</a></li>
                        <li><a class="hover:text-primary transition-colors" asp-controller="Bookings" asp-action="Index">Manage Bookings</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Support Center</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 mb-4 uppercase tracking-wider text-xs">Legal</h4>
                    <ul class="space-y-2">
                        <li><a class="hover:text-primary transition-colors" href="#">Privacy Policy</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Terms of Service</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Cookie Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-8 border-t border-slate-200">
                <p>© 2026 SkyReserve. Designed for Excellence.</p>
                <div class="flex gap-6">
                    <a href="#" class="text-slate-400 hover:text-primary transition-colors"><i class="fa-brands fa-twitter text-xl"></i></a>
                    <a href="#" class="text-slate-400 hover:text-primary transition-colors"><i class="fa-brands fa-linkedin text-xl"></i></a>
                    <a href="#" class="text-slate-400 hover:text-primary transition-colors"><i class="fa-brands fa-instagram text-xl"></i></a>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
