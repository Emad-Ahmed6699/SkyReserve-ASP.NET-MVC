@model FlightReservationSystem.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-4">
                <a asp-action="Index" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Booking Details</h1>
                    <p class="text-sm text-slate-500">Reference ID: #@Model.Id.ToString("D6")</p>
                </div>
            </div>
            <div class="flex gap-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-5 py-2.5 bg-white border border-slate-200 text-slate-700 font-bold rounded-lg hover:bg-slate-50 transition-all text-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">edit</span> Edit
                </a>
                <button onclick="window.print()" class="px-5 py-2.5 bg-white border border-slate-200 text-slate-700 font-bold rounded-lg hover:bg-slate-50 transition-all text-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">print</span> Print
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Main Details -->
            <div class="md:col-span-2 space-y-8">
                <!-- Passenger Information -->
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-8">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-lg">person</span> Passenger Info
                    </h3>
                    <div class="grid grid-cols-2 gap-8">
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase mb-1">Full Name</div>
                            <div class="text-base font-bold text-slate-900">@Model.Passenger?.FullName</div>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase mb-1">Seat Assignment</div>
                            <div class="text-xl font-bold text-primary">@Model.SeatNumber</div>
                        </div>
                    </div>
                </div>

                <!-- Flight Information -->
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-8">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-lg">flight_takeoff</span> Flight Info
                    </h3>
                    <div class="grid grid-cols-2 gap-8 mb-8">
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase mb-1">Flight Number</div>
                            <div class="text-base font-bold text-slate-900">@Model.Flight?.FlightNumber</div>
                        </div>
                    </div>
                    <div class="p-6 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between">
                        <div class="text-center md:text-left">
                            <div class="text-xl font-bold text-slate-900">@Model.Flight?.FromCity</div>
                            <div class="text-xs font-bold text-slate-400 uppercase mt-1">Origin</div>
                        </div>
                        <div class="flex-1 flex flex-col items-center px-8">
                            <div class="w-full h-px bg-slate-200 relative">
                                <span class="material-symbols-outlined absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-primary text-lg bg-slate-50 px-2">flight</span>
                            </div>
                        </div>
                        <div class="text-center md:text-right">
                            <div class="text-xl font-bold text-slate-900">@Model.Flight?.ToCity</div>
                            <div class="text-xs font-bold text-slate-400 uppercase mt-1">Destination</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar Info -->
            <div class="space-y-8">
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-8 text-center">
                    <div class="w-32 h-32 bg-slate-50 border border-slate-100 rounded-xl mx-auto mb-6 flex items-center justify-center">
                        <span class="material-symbols-outlined !text-6xl text-slate-300">qr_code_2</span>
                    </div>
                    <div class="text-xs font-bold text-slate-400 uppercase mb-1">Booking Hash</div>
                    <div class="text-sm font-mono font-bold text-slate-900">RES-@Model.Id.ToString("X4")</div>
                </div>

                <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-6">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
                        <h4 class="text-emerald-900 font-bold text-sm uppercase">Active Manifest</h4>
                    </div>
                    <p class="text-xs text-emerald-800/60 leading-relaxed">
                        This reservation is confirmed and synced with flight inventory.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
