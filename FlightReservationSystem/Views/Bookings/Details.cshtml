@model FlightReservationSystem.Models.Booking

@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="max-w-[1280px] mx-auto px-8 py-12">
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
            <a asp-action="Index" class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container text-primary hover:bg-primary hover:text-on-primary transition-all shadow-sm">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Booking Confirmation</h1>
        </div>
        <div class="flex gap-4">
            <button class="bg-white border border-outline text-on-surface-variant px-6 py-3 rounded-xl font-headline-md flex items-center gap-2 hover:bg-slate-50 transition-all active:scale-95 shadow-sm">
                <span class="material-symbols-outlined">print</span> Print Ticket
            </button>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-primary-container text-on-primary px-6 py-3 rounded-xl font-headline-md flex items-center gap-2 hover:bg-primary transition-all active:scale-95 shadow-md">
                <span class="material-symbols-outlined">edit</span> Modify
            </a>
        </div>
    </div>

    <div class="max-w-4xl mx-auto">
        <!-- Ticket Visual -->
        <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-2xl overflow-hidden flex flex-col md:flex-row relative">
            <!-- Left Side: Flight Info -->
            <div class="flex-1 p-10 border-r-2 border-dashed border-slate-100 relative">
                <!-- Decorative punch holes -->
                <div class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 w-8 h-8 bg-background border border-slate-200 rounded-full hidden md:block"></div>
                <div class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 w-8 h-8 bg-background border border-slate-200 rounded-full hidden md:block"></div>
                
                <div class="flex justify-between items-start mb-10">
                    <div>
                        <div class="text-xs font-bold text-primary uppercase tracking-[0.2em] mb-2">Electronic Ticket</div>
                        <h2 class="text-3xl font-black text-on-surface uppercase">@Model.Flight?.FlightNumber</h2>
                    </div>
                    <div class="w-12 h-12 bg-primary/5 rounded-2xl flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined !text-3xl">flight</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-12 mb-10">
                    <div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Passenger</div>
                        <div class="font-bold text-on-surface">@Model.Passenger?.FullName</div>
                    </div>
                    <div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Seat</div>
                        <div class="font-bold text-primary text-xl">@Model.SeatNumber</div>
                    </div>
                </div>

                <div class="flex items-center justify-between gap-6 py-8 border-t border-b border-slate-50">
                    <div class="text-center md:text-left">
                        <div class="text-3xl font-black text-on-surface uppercase">@Model.Flight?.FromCity.Substring(0, Math.Min(3, Model.Flight?.FromCity.Length ?? 0))</div>
                        <div class="text-xs font-medium text-on-surface-variant">@Model.Flight?.FromCity</div>
                    </div>
                    <div class="flex-1 flex flex-col items-center">
                        <span class="material-symbols-outlined text-slate-300">east</span>
                        <span class="text-[10px] font-bold text-slate-300 uppercase tracking-widest mt-1">Non-Stop</span>
                    </div>
                    <div class="text-center md:text-right">
                        <div class="text-3xl font-black text-on-surface uppercase">@Model.Flight?.ToCity.Substring(0, Math.Min(3, Model.Flight?.ToCity.Length ?? 0))</div>
                        <div class="text-xs font-medium text-on-surface-variant">@Model.Flight?.ToCity</div>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-6 mt-10">
                    <div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Date</div>
                        <div class="text-sm font-bold text-on-surface">Oct 24, 2024</div>
                    </div>
                    <div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Boarding</div>
                        <div class="text-sm font-bold text-on-surface">08:45 AM</div>
                    </div>
                    <div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Gate</div>
                        <div class="text-sm font-bold text-on-surface">B-12</div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Stub / QR -->
            <div class="w-full md:w-72 bg-slate-50 p-10 flex flex-col items-center justify-center text-center">
                <div class="w-40 h-40 bg-white p-4 rounded-3xl shadow-sm border border-slate-100 mb-6 flex items-center justify-center">
                    <!-- Placeholder for QR Code -->
                    <span class="material-symbols-outlined !text-[120px] text-slate-200">qr_code_2</span>
                </div>
                <div class="space-y-1">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Booking ID</div>
                    <div class="font-mono font-bold text-on-surface">SR-BK-@Model.Id.ToString("D4")</div>
                </div>
                <div class="mt-8 pt-8 border-t border-slate-200 w-full">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Class</div>
                    <span class="bg-primary text-on-primary px-4 py-1 rounded-full text-[10px] font-black uppercase tracking-widest">Premium Economy</span>
                </div>
            </div>
        </div>

        <!-- Additional Actions -->
        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-3xl border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 bg-surface-container text-primary rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined">mail</span>
                </div>
                <div class="flex-1">
                    <div class="text-sm font-bold text-on-surface">Email Confirmation</div>
                    <div class="text-xs text-on-surface-variant">Resend to passenger's email</div>
                </div>
                <button class="text-primary font-bold text-sm">Resend</button>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 bg-surface-container text-primary rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined">calendar_add_on</span>
                </div>
                <div class="flex-1">
                    <div class="text-sm font-bold text-on-surface">Add to Calendar</div>
                    <div class="text-xs text-on-surface-variant">Sync with Google or Apple</div>
                </div>
                <button class="text-primary font-bold text-sm">Add</button>
            </div>
        </div>
    </div>
</div>
