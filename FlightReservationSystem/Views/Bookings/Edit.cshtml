@model FlightReservationSystem.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[600px] mx-auto">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-8">
            <a asp-action="Index" class="text-slate-400 hover:text-slate-600 transition-colors">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <h1 class="text-2xl font-bold text-slate-900">Edit Reservation</h1>
        </div>

        <!-- Form Card -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-8 lg:p-10">
            <form asp-action="Edit" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 p-4 rounded-lg border border-rose-100"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="space-y-4">
                    <div class="space-y-1.5">
                        <label asp-for="FlightId" class="text-xs font-bold text-slate-500 uppercase">Flight Route</label>
                        <select asp-for="FlightId" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all cursor-pointer" asp-items="ViewBag.FlightId"></select>
                        <span asp-validation-for="FlightId" class="text-xs text-rose-600"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="PassengerId" class="text-xs font-bold text-slate-500 uppercase">Passenger</label>
                        <select asp-for="PassengerId" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all cursor-pointer" asp-items="ViewBag.PassengerId"></select>
                        <span asp-validation-for="PassengerId" class="text-xs text-rose-600"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="SeatNumber" class="text-xs font-bold text-slate-500 uppercase">Seat Number</label>
                        <input asp-for="SeatNumber" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all uppercase" placeholder="e.g. 12A" />
                        <span asp-validation-for="SeatNumber" class="text-xs text-rose-600"></span>
                    </div>
                </div>

                <div class="pt-6 border-t border-slate-100 flex items-center gap-4">
                    <button type="submit" class="px-8 py-3 bg-primary text-white font-bold rounded-lg hover:bg-primary/90 transition-all shadow-sm">
                        Save Changes
                    </button>
                    <a asp-action="Index" class="text-sm font-bold text-slate-500 hover:text-slate-700">Cancel</a>
                </div>
            </form>
        </div>

        <!-- Danger Zone -->
        <div class="mt-8 bg-white border border-rose-100 rounded-xl p-6">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-sm font-bold text-rose-600 uppercase mb-1">Danger Zone</h3>
                    <p class="text-xs text-slate-500">Cancelling this booking will release the assigned seat back to inventory.</p>
                </div>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="px-4 py-2 border border-rose-200 text-rose-600 text-xs font-bold rounded-lg hover:bg-rose-50 transition-colors">
                    Delete Booking
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
