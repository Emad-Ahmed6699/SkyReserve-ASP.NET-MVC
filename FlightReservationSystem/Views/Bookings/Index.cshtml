@model IEnumerable<FlightReservationSystem.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-5 mt-5">
    <div class="d-flex justify-content-between align-items-end mb-5" data-aos="fade-down">
        <div>
            <h1 class="display-4 fw-bold">Manage Bookings</h1>
            <p class="text-muted">Your upcoming journeys and past travel history.</p>
        </div>
        <a asp-action="Create" class="btn btn-premium px-4">
            <i class="fa-solid fa-plus me-2"></i>New Booking
        </a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model) {
            <div class="col-md-6 col-lg-4" data-aos="zoom-in">
                <div class="glass-card h-100 position-relative overflow-hidden">
                    <!-- Ticket Punch Effect -->
                    <div style="position: absolute; left: -10px; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; background: var(--bg-deep); border-radius: 50%;"></div>
                    <div style="position: absolute; right: -10px; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; background: var(--bg-deep); border-radius: 50%;"></div>
                    
                    <div class="d-flex justify-content-between mb-4">
                        <div class="text-primary fw-bold">BOARDING PASS</div>
                        <div class="text-white opacity-50"><i class="fa-solid fa-qrcode"></i></div>
                    </div>

                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">PASSENGER</small>
                        <h5 class="text-white">@item.Passenger.FullName</h5>
                    </div>

                    <div class="d-flex justify-content-between mb-4 pb-4 border-bottom border-secondary border-opacity-25">
                        <div>
                            <small class="text-muted d-block mb-1">FLIGHT</small>
                            <h5 class="text-white">#@item.Flight.FlightNumber</h5>
                        </div>
                        <div class="text-end">
                            <small class="text-muted d-block mb-1">SEAT</small>
                            <h5 class="text-primary">@item.SeatNumber</h5>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light border-opacity-25"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light border-opacity-25"><i class="fa-solid fa-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-opacity-25"><i class="fa-solid fa-trash"></i></a>
                        </div>
                        <span class="badge bg-success bg-opacity-25 text-success">Confirmed</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
