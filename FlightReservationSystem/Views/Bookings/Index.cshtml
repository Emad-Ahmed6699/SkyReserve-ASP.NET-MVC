@model IEnumerable<FlightReservationSystem.Models.Booking>

@{
    ViewData["Title"] = "Reservations";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[1280px] mx-auto">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
            <div>
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Reservations</h1>
                <p class="text-slate-500 mt-1">Manage passenger bookings and flight assignments.</p>
            </div>
            <a asp-action="Create" class="px-6 py-3 bg-primary text-white font-bold rounded-xl hover:bg-primary/90 transition-all shadow-sm flex items-center gap-2">
                <span class="material-symbols-outlined">add</span>
                New Reservation
            </a>
        </div>

        <!-- Table Card -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200">
                            <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest">Booking ID</th>
                            <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest">Passenger</th>
                            <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest">Flight</th>
                            <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest">Seat</th>
                            <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model) {
                            <tr class="hover:bg-slate-50 transition-colors group">
                                <td class="px-6 py-5">
                                    <span class="text-sm font-mono font-bold text-slate-400">#@item.Id.ToString("D5")</span>
                                </td>
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 text-xs font-bold">
                                            @(item.Passenger?.FullName?.Substring(0, 1) ?? "P")
                                        </div>
                                        <span class="text-sm font-bold text-slate-900">@item.Passenger?.FullName</span>
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    <div class="space-y-0.5">
                                        <div class="text-sm font-bold text-slate-900">@item.Flight?.FlightNumber</div>
                                        <div class="text-[10px] font-bold text-slate-400 uppercase">@item.Flight?.FromCity → @item.Flight?.ToCity</div>
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    <span class="px-2.5 py-1 bg-primary/10 text-primary text-xs font-bold rounded-md">@item.SeatNumber</span>
                                </td>
                                <td class="px-6 py-5">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-2 text-slate-400 hover:text-primary hover:bg-primary/5 rounded-lg transition-all" title="Edit">
                                            <span class="material-symbols-outlined text-xl">edit</span>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-all" title="Details">
                                            <span class="material-symbols-outlined text-xl">visibility</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-all" title="Delete">
                                            <span class="material-symbols-outlined text-xl">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.Any()) {
                <div class="p-20 text-center">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-slate-300 !text-3xl">confirmation_number</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">No reservations found</h3>
                    <p class="text-slate-500 mt-1">Start by creating a new reservation for a passenger.</p>
                </div>
            }
        </div>
    </div>
</div>
