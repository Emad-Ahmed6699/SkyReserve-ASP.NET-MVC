@model FlightReservationSystem.Models.Booking

@{
    ViewData["Title"] = "New Booking";
}

<div class="max-w-[1280px] mx-auto px-8 py-12">
    <div class="flex items-center gap-4 mb-8">
        <a asp-action="Index" class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container text-primary hover:bg-primary hover:text-on-primary transition-all shadow-sm">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Create New Booking</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Form -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-8">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="bg-error/10 text-error p-4 rounded-xl mb-6 text-sm"></div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2 md:col-span-2">
                                <label asp-for="FlightId" class="font-label-md text-on-surface-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm text-primary">flight_takeoff</span> Select Flight
                                </label>
                                <select asp-for="FlightId" class="w-full bg-slate-50 border-none rounded-xl p-4 focus:ring-2 focus:ring-primary focus:bg-white transition-all appearance-none cursor-pointer" asp-items="ViewBag.FlightId">
                                    <option value="" disabled selected>Choose a scheduled flight...</option>
                                </select>
                                <span asp-validation-for="FlightId" class="text-xs text-error"></span>
                            </div>

                            <div class="space-y-2">
                                <label asp-for="PassengerId" class="font-label-md text-on-surface-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm text-primary">person</span> Select Passenger
                                </label>
                                <select asp-for="PassengerId" class="w-full bg-slate-50 border-none rounded-xl p-4 focus:ring-2 focus:ring-primary focus:bg-white transition-all appearance-none cursor-pointer" asp-items="ViewBag.PassengerId">
                                    <option value="" disabled selected>Choose a passenger...</option>
                                </select>
                                <span asp-validation-for="PassengerId" class="text-xs text-error"></span>
                            </div>

                            <div class="space-y-2">
                                <label asp-for="SeatNumber" class="font-label-md text-on-surface-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm text-primary">chair</span> Seat Assignment
                                </label>
                                <input asp-for="SeatNumber" class="w-full bg-slate-50 border-none rounded-xl p-4 focus:ring-2 focus:ring-primary focus:bg-white transition-all" placeholder="e.g. 12A" />
                                <span asp-validation-for="SeatNumber" class="text-xs text-error"></span>
                            </div>
                        </div>

                        <div class="mt-10 flex gap-4">
                            <button type="submit" class="bg-primary text-on-primary px-8 py-4 rounded-xl font-headline-md flex items-center gap-2 hover:bg-primary/90 transition-all active:scale-95 shadow-lg">
                                <span class="material-symbols-outlined">confirmation_number</span> Confirm Booking
                            </button>
                            <a asp-action="Index" class="border border-outline text-on-surface-variant px-8 py-4 rounded-xl font-headline-md bg-white hover:bg-slate-50 transition-all active:scale-95">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="space-y-6">
            <div class="bg-surface-container p-8 rounded-3xl border border-slate-200">
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6">Booking Summary</h3>
                <div class="space-y-4">
                    <div class="p-4 bg-white rounded-2xl border border-slate-100 flex items-center gap-4">
                        <div class="w-10 h-10 bg-primary/5 text-primary rounded-xl flex items-center justify-center">
                            <span class="material-symbols-outlined">receipt</span>
                        </div>
                        <div>
                            <div class="text-xs text-slate-400 uppercase font-bold tracking-widest">Base Fare</div>
                            <div class="text-sm font-bold text-on-surface">Calculated on select</div>
                        </div>
                    </div>
                    <div class="p-4 bg-white rounded-2xl border border-slate-100 flex items-center gap-4">
                        <div class="w-10 h-10 bg-primary/5 text-primary rounded-xl flex items-center justify-center">
                            <span class="material-symbols-outlined">luggage</span>
                        </div>
                        <div>
                            <div class="text-xs text-slate-400 uppercase font-bold tracking-widest">Baggage</div>
                            <div class="text-sm font-bold text-on-surface">23kg Included</div>
                        </div>
                    </div>
                </div>
                <div class="mt-8 pt-8 border-t border-slate-200">
                    <p class="text-xs text-on-surface-variant leading-relaxed italic">
                        * Final price includes all taxes and airport fees. A confirmation email will be sent to the passenger upon successful booking.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
