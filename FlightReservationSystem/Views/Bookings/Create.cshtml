@model FlightReservationSystem.Models.Booking

@{
    ViewData["Title"] = "New Booking";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[600px] mx-auto">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-8">
            <a asp-action="Index" class="text-slate-400 hover:text-slate-600 transition-colors">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <h1 class="text-2xl font-bold text-slate-900">New Reservation</h1>
        </div>

        <!-- Form Card -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-8 lg:p-10">
            <form asp-action="Create" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 p-4 rounded-lg border border-rose-100"></div>
                
                <div class="space-y-4">
                    <div class="space-y-1.5">
                        <label asp-for="FlightId" class="text-xs font-bold text-slate-500 uppercase">Flight Route</label>
                        <select asp-for="FlightId" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all cursor-pointer" asp-items="ViewBag.FlightId">
                            <option value="" disabled selected>Select a scheduled flight...</option>
                        </select>
                        <span asp-validation-for="FlightId" class="text-xs text-rose-600"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="PassengerId" class="text-xs font-bold text-slate-500 uppercase">Passenger</label>
                        <select asp-for="PassengerId" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all cursor-pointer" asp-items="ViewBag.PassengerId">
                            <option value="" disabled selected>Select a passenger...</option>
                        </select>
                        <span asp-validation-for="PassengerId" class="text-xs text-rose-600"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="SeatNumber" class="text-xs font-bold text-slate-500 uppercase">Seat Number</label>
                        <input asp-for="SeatNumber" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all uppercase" placeholder="e.g. 12A" />
                        <span asp-validation-for="SeatNumber" class="text-xs text-rose-600"></span>
                    </div>
                </div>

                <div class="pt-6 border-t border-slate-100 flex items-center gap-4">
                    <button type="submit" class="px-8 py-3 bg-primary text-white font-bold rounded-lg hover:bg-primary/90 transition-all shadow-sm">
                        Create Booking
                    </button>
                    <a asp-action="Index" class="text-sm font-bold text-slate-500 hover:text-slate-700">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
