@model FlightReservationSystem.Models.Booking

@{
    ViewData["Title"] = "Cancel Booking";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[500px] mx-auto">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-rose-50 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-4 border border-rose-100">
                <span class="material-symbols-outlined !text-3xl">delete</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900">Cancel Reservation</h1>
            <p class="text-sm text-slate-500 mt-2">Are you sure you want to permanently remove this booking?</p>
        </div>

        <!-- Info Card -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
            <div class="p-6 bg-slate-50 border-b border-slate-200">
                <div class="text-xs font-bold text-slate-400 uppercase mb-1">Booking Reference</div>
                <div class="text-lg font-bold text-slate-900">#@Model.Id.ToString("D6")</div>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-slate-500 uppercase">Passenger</span>
                    <span class="text-sm font-bold text-slate-900">@Model.Passenger?.FullName</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-slate-500 uppercase">Flight</span>
                    <span class="text-sm font-bold text-slate-900">@Model.Flight?.FlightNumber</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-slate-500 uppercase">Seat</span>
                    <span class="text-sm font-bold text-primary">@Model.SeatNumber</span>
                </div>
            </div>
        </div>

        <!-- Action Form -->
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="flex flex-col gap-3">
                <button type="submit" class="w-full py-3.5 bg-rose-600 text-white font-bold rounded-lg hover:bg-rose-700 transition-all shadow-sm">
                    Confirm Cancellation
                </button>
                <a asp-action="Index" class="w-full py-3.5 bg-white border border-slate-200 text-slate-600 font-bold rounded-lg hover:bg-slate-50 transition-all text-center">
                    Keep Booking
                </a>
            </div>
        </form>

        <!-- Policy Note -->
        <div class="mt-8 p-6 bg-slate-900 rounded-xl">
            <div class="flex gap-4">
                <span class="material-symbols-outlined text-primary">info</span>
                <p class="text-[11px] text-slate-400 leading-relaxed">
                    By confirming this action, the allocated seat will be immediately released back to the inventory. This action cannot be undone.
                </p>
            </div>
        </div>
    </div>
</div>
