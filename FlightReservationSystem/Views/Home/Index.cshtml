@{
    ViewData["Title"] = "SkyReserve - Elevate Your Journey";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<!-- Hero Section -->
<section class="relative h-screen flex items-center justify-center overflow-hidden bg-[#050b14]">
    <!-- Dynamic Background -->
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-primary/20 via-transparent to-[#050b14]"></div>
        <img src="https://images.unsplash.com/photo-1542296332-2e4473faf563?q=80&w=2000" class="w-full h-full object-cover opacity-40 scale-110 animate-slow-zoom" alt="SkyReserve Hero" />
    </div>

    <!-- Floating Particles -->
    <div class="absolute inset-0 pointer-events-none z-10" id="hero-particles"></div>

    <div class="max-w-[1400px] mx-auto px-8 w-full relative z-50 -mt-24">
        <div class="max-w-3xl">
            <div class="hero-reveal opacity-0">
                <span class="inline-block px-4 py-1.5 mb-6 rounded-full bg-primary/20 border border-primary/30 text-primary-container text-xs font-black uppercase tracking-[0.3em]">
                    The Future of Aviation
                </span>
                <h1 class="font-display text-[clamp(3rem,8vw,6rem)] leading-[0.9] text-white font-black tracking-tighter mb-8">
                    Elevate Your <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-container via-blue-400 to-emerald-400">Atmosphere</span>
                </h1>
                <p class="text-slate-400 text-xl md:text-2xl font-medium max-w-xl mb-12 leading-relaxed">
                    Experience the pinnacle of travel technology. SkyReserve seamlessly connects global nodes with unmatched precision and luxury.
                </p>
                <div class="flex flex-wrap gap-6">
                    <a asp-controller="Flights" asp-action="Index" class="px-10 py-5 bg-primary text-white rounded-[2rem] font-black shadow-2xl shadow-primary/20 hover:scale-105 transition-all active:scale-95 flex items-center gap-3 group">
                        Begin Expedition
                        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </a>
                    <a asp-controller="Flights" asp-action="Index" class="px-10 py-5 bg-white/5 backdrop-blur-xl border border-white/10 text-white rounded-[2rem] font-black hover:bg-white/10 transition-all">
                        View Fleet
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Bar -->
    <div class="absolute bottom-0 left-0 w-full z-30 p-8">
        <div class="max-w-[1400px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 py-8 border-t border-white/10">
            <div class="stat-item opacity-0">
                <div class="text-4xl font-black text-white mb-1">500+</div>
                <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Global Nodes</div>
            </div>
            <div class="stat-item opacity-0">
                <div class="text-4xl font-black text-white mb-1">12M</div>
                <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Atmospheric Miles</div>
            </div>
            <div class="stat-item opacity-0">
                <div class="text-4xl font-black text-white mb-1">99.9%</div>
                <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Precision Rating</div>
            </div>
            <div class="stat-item opacity-0">
                <div class="text-4xl font-black text-white mb-1">24/7</div>
                <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Node Monitoring</div>
            </div>
        </div>
    </div>
</section>

<!-- Search Console -->
<section class="relative z-40 -mt-16 px-8 max-w-[1400px] mx-auto mb-32">
    <div class="bg-[#0b1c30] p-4 rounded-[3rem] shadow-[0_32px_64px_-16px_rgba(0,0,0,0.5)] border border-white/5">
        <div class="bg-white/5 rounded-[2.5rem] p-8 md:p-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
                <div class="space-y-4">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-primary">location_on</span> Departure Node
                    </label>
                    <input type="text" class="w-full bg-white/5 border-none rounded-2xl p-5 text-white placeholder-slate-600 focus:ring-2 focus:ring-primary focus:bg-white/10 transition-all" placeholder="Enter Origin" />
                </div>
                <div class="space-y-4">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-primary">flight_land</span> Arrival Node
                    </label>
                    <input type="text" class="w-full bg-white/5 border-none rounded-2xl p-5 text-white placeholder-slate-600 focus:ring-2 focus:ring-primary focus:bg-white/10 transition-all" placeholder="Enter Destination" />
                </div>
                <div class="space-y-4">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-primary">calendar_month</span> Expedition Date
                    </label>
                    <input type="date" class="w-full bg-white/5 border-none rounded-2xl p-5 text-white focus:ring-2 focus:ring-primary focus:bg-white/10 transition-all [color-scheme:dark]" />
                </div>
                <div class="flex items-end">
                    <a asp-controller="Flights" asp-action="Index" class="w-full bg-primary text-white rounded-2xl h-[64px] font-black flex items-center justify-center gap-3 hover:bg-blue-600 transition-all active:scale-95 shadow-xl shadow-primary/20">
                        <span class="material-symbols-outlined">radar</span>
                        Sync Itinerary
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Grid -->
<section class="max-w-[1400px] mx-auto px-8 mb-32">
    <div class="text-center mb-20">
        <h2 class="text-5xl font-black text-slate-900 tracking-tighter mb-4">Core Advantage</h2>
        <p class="text-slate-500 font-medium max-w-xl mx-auto">Propelling travel into the next century with integrated intelligence.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="feature-card glass-card p-10 group cursor-default">
            <div class="w-16 h-16 bg-primary/5 text-primary rounded-3xl flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all duration-500">
                <span class="material-symbols-outlined !text-3xl">terminal</span>
            </div>
            <h3 class="text-2xl font-black text-slate-900 mb-4 tracking-tight">Smart Manifest</h3>
            <p class="text-slate-500 leading-relaxed font-medium">Automated booking synchronization across global aviation networks in milliseconds.</p>
        </div>
        <div class="feature-card glass-card p-10 group cursor-default">
            <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-3xl flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-white transition-all duration-500">
                <span class="material-symbols-outlined !text-3xl">shield_moon</span>
            </div>
            <h3 class="text-2xl font-black text-slate-900 mb-4 tracking-tight">Biometric Flow</h3>
            <p class="text-slate-500 leading-relaxed font-medium">Experience zero-touch boarding protocols with our proprietary identity mesh technology.</p>
        </div>
        <div class="feature-card glass-card p-10 group cursor-default">
            <div class="w-16 h-16 bg-amber-50 text-amber-600 rounded-3xl flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-amber-500 group-hover:text-white transition-all duration-500">
                <span class="material-symbols-outlined !text-3xl">rocket_launch</span>
            </div>
            <h3 class="text-2xl font-black text-slate-900 mb-4 tracking-tight">Hyper-Sonic</h3>
            <p class="text-slate-500 leading-relaxed font-medium">Access next-generation sub-orbital routes that redefine the speed of global transit.</p>
        </div>
    </div>
</section>

<!-- Cinematic Experience -->
<section class="max-w-[1400px] mx-auto px-8 mb-32" id="cinematic-section">
    <div class="glass-card overflow-hidden relative group border border-white/10 shadow-2xl bg-[#0b1c30]">
        <div class="absolute inset-0 bg-gradient-to-t from-[#050b14] via-transparent to-transparent z-10 opacity-60"></div>
        
        <video 
            id="scroll-video"
            class="w-full h-full object-cover aspect-video opacity-90 transition-transform duration-1000 group-hover:scale-105"
            muted 
            loop 
            playsinline
            preload="auto">
            <source src="/videos/untitled_Runway Gen-4.5_2026-04-30_12-56-31.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>

        <div class="absolute bottom-0 left-0 p-8 md:p-16 z-20 w-full flex justify-between items-end">
            <div class="max-w-2xl">
                <span class="inline-block px-4 py-1.5 mb-4 rounded-full bg-primary/20 border border-primary/30 text-primary-container text-[10px] font-black uppercase tracking-[0.2em] backdrop-blur-md">
                    Live the Experience
                </span>
                <h2 class="text-4xl md:text-5xl font-black text-white tracking-tighter mb-4">
                    The Art of <br/> Modern Flight
                </h2>
                <p class="text-slate-300 font-medium max-w-lg">
                    Witness the convergence of technology and luxury in every frame of our journey.
                </p>
            </div>
            <div class="hidden md:block">
                <div class="w-24 h-24 rounded-full border border-white/20 flex items-center justify-center backdrop-blur-xl group-hover:border-primary/50 transition-colors">
                    <span class="material-symbols-outlined text-white text-5xl animate-pulse">play_circle</span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @@keyframes slow-zoom {
        from { transform: scale(1); }
        to { transform: scale(1.15); }
    }
    .animate-slow-zoom {
        animation: slow-zoom 20s ease-in-out infinite alternate;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        gsap.registerPlugin(ScrollTrigger);

        // Hero Animations
        gsap.to('.hero-reveal', {
            opacity: 1,
            y: 0,
            duration: 1.5,
            ease: 'expo.out',
            delay: 0.5
        });

        gsap.to('.stat-item', {
            opacity: 1,
            stagger: 0.2,
            duration: 1,
            ease: 'power3.out',
            delay: 1.2
        });

        // Feature Cards Scroll Animation
        gsap.from('.feature-card', {
            scrollTrigger: {
                trigger: '.feature-card',
                start: 'top 80%',
            },
            y: 60,
            opacity: 0,
            stagger: 0.2,
            duration: 1,
            ease: 'power4.out'
        });

        // Video Scroll Observer
        const video = document.getElementById('scroll-video');
        if (video) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        video.play().catch(e => console.log("Video play blocked or interrupted"));
                    } else {
                        video.pause();
                    }
                });
            }, { threshold: 0.3 }); // Play when 30% visible

            observer.observe(video);
        }

        // Cinematic Section GSAP Animation
        gsap.from('#cinematic-section', {
            scrollTrigger: {
                trigger: '#cinematic-section',
                start: 'top 85%',
            },
            y: 100,
            scale: 0.95,
            opacity: 0,
            duration: 1.5,
            ease: 'expo.out'
        });
    });
</script>
