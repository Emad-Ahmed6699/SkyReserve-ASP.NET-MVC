@{
    ViewData["Title"] = "Operations Dashboard";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[1200px] mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-10">
            <div>
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Operations Overview</h1>
                <p class="text-slate-500">Key metrics and recent system activity.</p>
            </div>
            <div class="flex gap-3">
                <button class="bg-white border border-slate-200 px-4 py-2 rounded-lg text-sm font-semibold text-slate-700 shadow-sm">
                    Refresh Data
                </button>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Total Revenue</div>
                <div class="text-2xl font-bold text-slate-900">$142,500</div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Active Flights</div>
                <div class="text-2xl font-bold text-slate-900">48</div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Total Passengers</div>
                <div class="text-2xl font-bold text-slate-900">15,240</div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">System Status</div>
                <div class="text-sm font-bold text-emerald-600 flex items-center gap-2">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full"></span> Online
                </div>
            </div>
        </div>

        <!-- Recent Activity Table -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="p-6 border-b border-slate-200">
                <h3 class="text-lg font-bold text-slate-900">Recent Flight Operations</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-slate-50 text-slate-500 text-xs font-bold uppercase tracking-wider">
                            <th class="px-6 py-4">Flight</th>
                            <th class="px-6 py-4">Route</th>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-bold text-slate-900">SR-102</td>
                            <td class="px-6 py-4 text-slate-600">LHR → JFK</td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 bg-emerald-100 text-emerald-700 text-[10px] font-bold rounded-md">EN ROUTE</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/Flights/Details/1" class="text-primary font-bold text-xs hover:underline">Details</a>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-bold text-slate-900">SR-445</td>
                            <td class="px-6 py-4 text-slate-600">NRT → SIN</td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 bg-amber-100 text-amber-700 text-[10px] font-bold rounded-md">DELAYED</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/Flights/Details/2" class="text-primary font-bold text-xs hover:underline">Details</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
