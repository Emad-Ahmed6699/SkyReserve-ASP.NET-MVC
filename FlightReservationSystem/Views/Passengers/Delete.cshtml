@model FlightReservationSystem.Models.Passenger

@{
    ViewData["Title"] = "Delete Passenger";
}

<div class="bg-slate-50 min-h-screen py-12 px-8 flex items-center justify-center">
    <div class="max-w-[500px] w-full">
        <div class="bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden">
            <div class="p-8 text-center border-b border-slate-100">
                <div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-full flex items-center justify-center mx-auto mb-6">
                    <span class="material-symbols-outlined !text-3xl">delete_forever</span>
                </div>
                <h2 class="text-xl font-bold text-slate-900">Delete Passenger?</h2>
                <p class="text-sm text-slate-500 mt-2">
                    Are you sure you want to remove <span class="font-bold text-slate-900">@Model.FullName</span>? This action cannot be undone.
                </p>
            </div>
            
            <div class="p-8 bg-slate-50">
                <div class="space-y-3 mb-8">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Passenger ID</span>
                        <span class="font-medium text-slate-900">#@Model.Id</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Passport</span>
                        <span class="font-medium text-slate-900 uppercase">@Model.PassportNumber</span>
                    </div>
                </div>

                <form asp-action="Delete" class="flex flex-col gap-3">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="w-full py-3 bg-rose-600 text-white font-bold rounded-lg hover:bg-rose-700 transition-all shadow-sm">
                        Confirm Deletion
                    </button>
                    <a asp-action="Index" class="w-full py-3 bg-white border border-slate-200 text-slate-600 font-bold rounded-lg text-center hover:bg-slate-50 transition-all">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
