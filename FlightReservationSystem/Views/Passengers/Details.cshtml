@model FlightReservationSystem.Models.Passenger

@{
    ViewData["Title"] = "Passenger Profile";
}

<div class="max-w-[1280px] mx-auto px-8 py-12">
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
            <a asp-action="Index" class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container text-primary hover:bg-primary hover:text-on-primary transition-all shadow-sm">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Passenger Profile</h1>
        </div>
        <div class="flex gap-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-primary-container text-on-primary px-6 py-3 rounded-xl font-headline-md flex items-center gap-2 hover:bg-primary transition-all active:scale-95 shadow-md">
                <span class="material-symbols-outlined">edit</span> Edit Profile
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="border border-error text-error px-6 py-3 rounded-xl font-headline-md bg-white hover:bg-error hover:text-white transition-all active:scale-95">
                Delete
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Profile Header/Card -->
        <div class="lg:col-span-4">
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden text-center p-10">
                <div class="w-32 h-32 bg-primary/10 rounded-full flex items-center justify-center text-primary mx-auto mb-6 relative">
                    <span class="material-symbols-outlined !text-[64px]">person</span>
                    <div class="absolute bottom-1 right-1 w-8 h-8 bg-green-500 border-4 border-white rounded-full"></div>
                </div>
                <h2 class="text-2xl font-bold text-on-surface mb-1">@Model.FullName</h2>
                <p class="text-primary font-bold text-sm uppercase tracking-widest mb-6">Elite Gold Member</p>
                
                <div class="grid grid-cols-2 gap-4 text-left border-t border-slate-100 pt-8">
                    <div>
                        <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Status</div>
                        <div class="flex items-center gap-2 text-on-surface font-bold">
                            <div class="w-2 h-2 bg-green-500 rounded-full"></div> Verified
                        </div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Miles</div>
                        <div class="text-on-surface font-bold">42,500</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail Sections -->
        <div class="lg:col-span-8 space-y-8">
            <!-- Identity Info -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-8 py-6 border-b border-slate-100 flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary">badge</span>
                    <h3 class="font-headline-sm text-headline-sm text-on-surface">Identity & Documents</h3>
                </div>
                <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Legal Full Name</div>
                        <div class="font-headline-md text-on-surface">@Model.FullName</div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Passport Number</div>
                        <div class="font-headline-md text-on-surface font-mono tracking-wider">@Model.PassportNumber</div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity Placeholder -->
            <div class="bg-surface-container rounded-3xl p-8 border border-slate-200">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="font-headline-sm text-headline-sm text-on-surface">Recent Activity</h3>
                    <button class="text-primary text-sm font-bold">View History</button>
                </div>
                <div class="space-y-4">
                    <div class="bg-white p-4 rounded-2xl flex items-center justify-between shadow-sm">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 bg-primary/5 text-primary rounded-xl flex items-center justify-center">
                                <span class="material-symbols-outlined">flight_takeoff</span>
                            </div>
                            <div>
                                <div class="font-bold text-on-surface text-sm">Booking Confirmed: SR-102</div>
                                <div class="text-xs text-on-surface-variant">LHR → JFK • 2 days ago</div>
                            </div>
                        </div>
                        <span class="text-sm font-bold text-on-surface">$850.00</span>
                    </div>
                    <div class="bg-white p-4 rounded-2xl flex items-center justify-between shadow-sm">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 bg-primary/5 text-primary rounded-xl flex items-center justify-center">
                                <span class="material-symbols-outlined">loyalty</span>
                            </div>
                            <div>
                                <div class="font-bold text-on-surface text-sm">Points Earned: +2,500</div>
                                <div class="text-xs text-on-surface-variant">Promotion Bonus • 5 days ago</div>
                            </div>
                        </div>
                        <span class="text-sm font-bold text-green-600">+2.5k</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
