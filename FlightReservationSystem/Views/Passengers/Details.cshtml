@model FlightReservationSystem.Models.Passenger

@{
    ViewData["Title"] = "Passenger Details";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[800px] mx-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-4">
                <a asp-action="Index" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <h1 class="text-2xl font-bold text-slate-900">Passenger Profile</h1>
            </div>
            <div class="flex items-center gap-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 border border-slate-200 rounded-lg text-sm font-bold text-slate-600 hover:bg-white transition-all">
                    Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="px-4 py-2 border border-rose-200 rounded-lg text-sm font-bold text-rose-600 hover:bg-rose-50 transition-all">
                    Delete
                </a>
            </div>
        </div>

        <!-- Info Card -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="p-8 border-b border-slate-100 flex items-center gap-6">
                <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center text-slate-300">
                    <span class="material-symbols-outlined !text-4xl">person</span>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-slate-900">@Model.FullName</h2>
                    <p class="text-sm text-slate-500">Passenger ID: #@Model.Id</p>
                </div>
            </div>
            
            <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">Full Name</label>
                    <p class="text-slate-900 font-medium">@Model.FullName</p>
                </div>
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-1">Passport Number</label>
                    <p class="text-slate-900 font-medium font-mono uppercase">@Model.PassportNumber</p>
                </div>
            </div>
        </div>

        <!-- System Info -->
        <div class="mt-8 p-6 bg-slate-100 rounded-xl border border-slate-200">
            <div class="flex items-start gap-4">
                <span class="material-symbols-outlined text-slate-400">info</span>
                <div>
                    <h4 class="text-sm font-bold text-slate-900">Administrative Note</h4>
                    <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                        This passenger record is active in the system. Any changes to the legal name or passport number should be verified against official documentation.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
