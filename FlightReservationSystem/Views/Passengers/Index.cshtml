@model IEnumerable<FlightReservationSystem.Models.Passenger>

@{
    ViewData["Title"] = "Passengers";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[1200px] mx-auto">
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Passenger Manifest</h1>
                <p class="text-sm text-slate-500">Manage all registered travelers and their documentation.</p>
            </div>
            <a asp-action="Create" class="px-6 py-2.5 bg-primary text-white font-bold rounded-lg hover:bg-primary/90 transition-all shadow-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">person_add</span>
                Add Passenger
            </a>
        </div>

        <!-- Table Card -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200">
                            <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Passenger Name</th>
                            <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Passport Number</th>
                            <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase tracking-wider text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model) {
                            <tr class="hover:bg-slate-50/50 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold text-xs">
                                            @item.FullName.Substring(0, 1)
                                        </div>
                                        <span class="font-bold text-slate-900">@item.FullName</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-600">@item.PassportNumber</td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-bold rounded-md border border-emerald-100">Verified</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-2 text-slate-400 hover:text-primary transition-colors">
                                            <span class="material-symbols-outlined text-lg">edit</span>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="p-2 text-slate-400 hover:text-slate-600 transition-colors">
                                            <span class="material-symbols-outlined text-lg">visibility</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-2 text-slate-400 hover:text-rose-600 transition-colors">
                                            <span class="material-symbols-outlined text-lg">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
