@model IEnumerable<FlightReservationSystem.Models.Passenger>

@{
    ViewData["Title"] = "Passengers";
}

<div class="container py-5 mt-5">
    <div class="d-flex justify-content-between align-items-end mb-5" data-aos="fade-down">
        <div>
            <h1 class="display-4 fw-bold">Passenger Directory</h1>
            <p class="text-muted">Manage traveler profiles and documentation.</p>
        </div>
        <a asp-action="Create" class="btn btn-premium px-4">
            <i class="fa-solid fa-user-plus me-2"></i>Add Passenger
        </a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model) {
            <div class="col-md-6 col-lg-4 col-xl-3" data-aos="flip-left">
                <div class="glass-card text-center h-100">
                    <div class="mb-4">
                        <div class="position-relative d-inline-block">
                            <img src="https://i.pravatar.cc/150?u=@item.PassportNumber" class="rounded-circle border border-3 border-primary p-1" style="width: 100px; height: 100px; object-fit: cover;" alt="Avatar">
                            <div class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle" style="width: 20px; height: 20px;"></div>
                        </div>
                    </div>
                    
                    <h5 class="text-white mb-1">@item.FullName</h5>
                    <p class="text-muted small mb-4"><i class="fa-solid fa-passport me-2"></i>@item.PassportNumber</p>
                    
                    <div class="d-flex justify-content-center gap-2 mt-auto">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light border-opacity-25 w-100">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light border-opacity-25 w-100">Profile</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-opacity-25"><i class="fa-solid fa-trash"></i></a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
