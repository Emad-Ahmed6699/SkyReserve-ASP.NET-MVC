@model FlightReservationSystem.Models.Users

@{
    ViewData["Title"] = "Create Account - SkyReserve";
}

<div class="min-h-[calc(100vh-64px)] flex items-center justify-center relative overflow-hidden bg-[#050b14]">
    <!-- Background Elements -->
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/30 via-transparent to-[#050b14]/80"></div>
        <img src="https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=2000" class="w-full h-full object-cover opacity-30" alt="SignUp Background" />
    </div>

    <div class="relative z-20 w-full max-w-[500px] px-6 py-12">
        <div class="glass-card p-10 md:p-12 border border-white/10 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.5)] bg-white/5 backdrop-blur-2xl rounded-[2.5rem]">
            <div class="text-center mb-10">
                <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-emerald-500/30">
                    <span class="material-symbols-outlined !text-3xl">person_add</span>
                </div>
                <h2 class="text-3xl font-black text-white tracking-tight mb-2">Create Account</h2>
                <p class="text-slate-400 font-medium text-sm">Join the elite network of global travelers.</p>
            </div>

            <form asp-action="SignUp" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-error/10 border border-error/20 rounded-2xl flex items-center gap-3 text-error text-sm"></div>
                
                <div class="space-y-2">
                    <label asp-for="Username" class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2 px-1">
                        <span class="material-symbols-outlined text-sm text-primary">person</span> Username
                    </label>
                    <input asp-for="Username" 
                           class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white placeholder-slate-600 focus:ring-2 focus:ring-primary focus:bg-white/10 focus:border-transparent transition-all outline-none" 
                           placeholder="Choose your callsign" />
                    <span asp-validation-for="Username" class="text-error text-[10px] font-bold px-1"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Email" class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2 px-1">
                        <span class="material-symbols-outlined text-sm text-primary">mail</span> Email Address
                    </label>
                    <input asp-for="Email" 
                           class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white placeholder-slate-600 focus:ring-2 focus:ring-primary focus:bg-white/10 focus:border-transparent transition-all outline-none" 
                           placeholder="name@skyreserve.com" />
                    <span asp-validation-for="Email" class="text-error text-[10px] font-bold px-1"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Password" class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2 px-1">
                        <span class="material-symbols-outlined text-sm text-primary">key</span> Security Password
                    </label>
                    <input asp-for="Password" type="password" 
                           class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white placeholder-slate-600 focus:ring-2 focus:ring-primary focus:bg-white/10 focus:border-transparent transition-all outline-none" 
                           placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-error text-[10px] font-bold px-1"></span>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full py-5 bg-primary text-white rounded-2xl font-black shadow-xl shadow-primary/20 hover:bg-blue-600 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-3 group">
                        Complete Registration
                        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">rocket_launch</span>
                    </button>
                </div>

                <div class="text-center pt-4 border-t border-white/5 mt-6">
                    <p class="text-slate-400 text-xs font-medium">
                        Already part of the fleet? 
                        <a asp-action="Login" class="text-white font-black hover:text-primary transition-colors underline underline-offset-4 decoration-primary/30">Login Now</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
