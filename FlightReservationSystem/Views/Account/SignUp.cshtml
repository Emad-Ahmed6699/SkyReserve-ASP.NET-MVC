@model FlightReservationSystem.Models.Users

@{
    ViewData["Title"] = "Register - SkyReserve";
}

<div class="min-h-[calc(100vh-64px)] flex items-center justify-center relative overflow-hidden bg-[#050b14] py-24">
    <!-- Premium Background -->
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/40 via-[#050b14]/80 to-[#050b14] z-10"></div>
        <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat opacity-50 scale-105 animate-slow-pan" 
             style="background-image: url('https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=2000');"></div>
    </div>

    <!-- Decorative Elements -->
    <div class="absolute top-1/4 -right-20 w-96 h-96 bg-primary/20 rounded-full blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-1/4 -left-20 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px] animate-pulse" style="animation-delay: 1.5s"></div>

    <div class="relative z-20 w-full max-w-[540px] px-6">
        <div class="glass-card p-10 md:p-14 border border-white/10 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.6)] bg-white/5 backdrop-blur-3xl rounded-[3rem] transition-all duration-500 hover:border-white/20">
            <div class="text-center mb-12">
                <div class="w-20 h-20 bg-gradient-to-br from-emerald-500/20 to-teal-400/20 text-emerald-400 rounded-3xl flex items-center justify-center mx-auto mb-6 border border-white/10 shadow-inner transition-transform duration-500 hover:-rotate-12">
                    <span class="material-symbols-outlined !text-4xl">person_add</span>
                </div>
                <h2 class="text-4xl font-black text-white tracking-tighter mb-3">Join the Elite</h2>
                <p class="text-slate-400 font-medium text-sm tracking-wide">Register to access premium flight services.</p>
            </div>

            <form asp-action="SignUp" method="post" class="space-y-7">
                <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-2xl flex items-center gap-3 text-red-400 text-xs font-bold"></div>
                
                <div class="space-y-3 group">
                    <label asp-for="Username" class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] flex items-center gap-2 px-1 transition-colors group-focus-within:text-primary">
                        <span class="material-symbols-outlined text-sm">badge</span> Chosen Callsign
                    </label>
                    <input asp-for="Username" 
                           class="w-full bg-white/10 border border-white/5 rounded-2xl p-5 text-white placeholder-slate-500 focus:ring-4 focus:ring-primary/20 focus:bg-white/15 focus:border-primary/50 transition-all outline-none font-medium" 
                           placeholder="Ex: Maverick_24" />
                    <span asp-validation-for="Username" class="text-red-400 text-[10px] font-black px-1"></span>
                </div>

                <div class="space-y-3 group">
                    <label asp-for="Email" class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] flex items-center gap-2 px-1 transition-colors group-focus-within:text-primary">
                        <span class="material-symbols-outlined text-sm">mail</span> Digital Identity
                    </label>
                    <input asp-for="Email" 
                           class="w-full bg-white/10 border border-white/5 rounded-2xl p-5 text-white placeholder-slate-500 focus:ring-4 focus:ring-primary/20 focus:bg-white/15 focus:border-primary/50 transition-all outline-none font-medium" 
                           placeholder="name@skyreserve.com" />
                    <span asp-validation-for="Email" class="text-red-400 text-[10px] font-black px-1"></span>
                </div>

                <div class="space-y-3 group">
                    <label asp-for="Password" class="text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] flex items-center gap-2 px-1 transition-colors group-focus-within:text-primary">
                        <span class="material-symbols-outlined text-sm">security</span> Security Protocol
                    </label>
                    <input asp-for="Password" type="password" 
                           class="w-full bg-white/10 border border-white/5 rounded-2xl p-5 text-white placeholder-slate-500 focus:ring-4 focus:ring-primary/20 focus:bg-white/15 focus:border-primary/50 transition-all outline-none font-medium" 
                           placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-400 text-[10px] font-black px-1"></span>
                </div>

                <div class="pt-6">
                    <button type="submit" class="w-full py-6 bg-primary text-white rounded-[1.5rem] font-black shadow-2xl shadow-primary/30 hover:bg-blue-600 hover:shadow-primary/40 hover:-translate-y-1 active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-4 group">
                        Confirm Registration
                        <span class="material-symbols-outlined group-hover:translate-x-2 transition-transform duration-300">rocket_launch</span>
                    </button>
                </div>

                <div class="text-center pt-8 border-t border-white/5 mt-4">
                    <p class="text-slate-400 text-sm font-bold">
                        Already in the system? 
                        <a asp-action="Login" class="text-white hover:text-primary transition-colors underline underline-offset-8 decoration-primary/40 hover:decoration-primary">Secure Login</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    @@keyframes slow-pan {
        0% { transform: scale(1.05) translateY(0); }
        100% { transform: scale(1.1) translateY(-2%); }
    }
    .animate-slow-pan {
        animation: slow-pan 25s ease-in-out infinite alternate;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
