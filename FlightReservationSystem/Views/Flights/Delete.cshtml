@model FlightReservationSystem.Models.Flight

@{
    ViewData["Title"] = "Delete Flight";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[600px] mx-auto text-center">
        <!-- Warning Icon -->
        <div class="w-20 h-20 bg-rose-100 text-rose-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <span class="material-symbols-outlined !text-4xl">warning</span>
        </div>

        <h1 class="text-2xl font-bold text-slate-900 mb-2">Delete Flight?</h1>
        <p class="text-slate-500 mb-8">Are you sure you want to permanently remove flight <span class="font-bold text-slate-900">@Model.FlightNumber</span>? This action cannot be undone.</p>

        <!-- Details Card -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 mb-8 text-left">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase">Route</p>
                    <p class="font-bold text-slate-900">@Model.FromCity &rarr; @Model.ToCity</p>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase">Price</p>
                    <p class="font-bold text-slate-900">$@Model.Price.ToString("N2")</p>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <form asp-action="Delete" class="flex flex-col gap-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="w-full py-3 bg-rose-600 text-white font-bold rounded-lg hover:bg-rose-700 transition-all shadow-sm">
                Confirm Deletion
            </button>
            <a asp-action="Index" class="w-full py-3 bg-white border border-slate-200 text-slate-600 font-bold rounded-lg hover:bg-slate-50 transition-all">
                Cancel
            </a>
        </form>
    </div>
</div>
