@model FlightReservationSystem.Models.Flight

@{
    ViewData["Title"] = "Add New Flight";
}

<div class="max-w-[1280px] mx-auto px-8 py-12">
    <div class="flex items-center gap-4 mb-8">
        <a asp-action="Index" class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container text-primary hover:bg-primary hover:text-on-primary transition-all shadow-sm">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Add New Flight</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Form -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-8">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="bg-error/10 text-error p-4 rounded-xl mb-6 text-sm"></div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label asp-for="FlightNumber" class="font-label-md text-on-surface-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm text-primary">tag</span> Flight Number
                                </label>
                                <input asp-for="FlightNumber" class="w-full bg-slate-50 border-none rounded-xl p-4 focus:ring-2 focus:ring-primary focus:bg-white transition-all" placeholder="e.g. SR-123" />
                                <span asp-validation-for="FlightNumber" class="text-xs text-error"></span>
                            </div>

                            <div class="space-y-2">
                                <label asp-for="Price" class="font-label-md text-on-surface-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm text-primary">payments</span> Price (USD)
                                </label>
                                <input asp-for="Price" class="w-full bg-slate-50 border-none rounded-xl p-4 focus:ring-2 focus:ring-primary focus:bg-white transition-all" placeholder="0.00" />
                                <span asp-validation-for="Price" class="text-xs text-error"></span>
                            </div>

                            <div class="space-y-2">
                                <label asp-for="FromCity" class="font-label-md text-on-surface-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm text-primary">flight_takeoff</span> Origin City
                                </label>
                                <input asp-for="FromCity" class="w-full bg-slate-50 border-none rounded-xl p-4 focus:ring-2 focus:ring-primary focus:bg-white transition-all" placeholder="City or Airport" />
                                <span asp-validation-for="FromCity" class="text-xs text-error"></span>
                            </div>

                            <div class="space-y-2">
                                <label asp-for="ToCity" class="font-label-md text-on-surface-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm text-primary">flight_land</span> Destination City
                                </label>
                                <input asp-for="ToCity" class="w-full bg-slate-50 border-none rounded-xl p-4 focus:ring-2 focus:ring-primary focus:bg-white transition-all" placeholder="City or Airport" />
                                <span asp-validation-for="ToCity" class="text-xs text-error"></span>
                            </div>
                        </div>

                        <div class="mt-10 flex gap-4">
                            <button type="submit" class="bg-primary text-on-primary px-8 py-4 rounded-xl font-headline-md flex items-center gap-2 hover:bg-primary/90 transition-all active:scale-95 shadow-lg">
                                <span class="material-symbols-outlined">add</span> Create Flight
                            </button>
                            <a asp-action="Index" class="border border-outline text-on-surface-variant px-8 py-4 rounded-xl font-headline-md bg-white hover:bg-slate-50 transition-all active:scale-95">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="space-y-6">
            <div class="bg-primary-container p-8 rounded-3xl text-on-primary">
                <span class="material-symbols-outlined !text-4xl mb-4">info</span>
                <h3 class="font-headline-md text-headline-md mb-2">Flight Creation Guide</h3>
                <p class="text-sm opacity-90 leading-relaxed">
                    Ensure all flight numbers follow the internal standard (e.g. SR-XXX). Flight prices are displayed in USD and will be converted automatically at checkout.
                </p>
            </div>
            
            <div class="bg-surface-container p-8 rounded-3xl border border-slate-200">
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-4">Need Help?</h3>
                <p class="text-sm text-on-surface-variant mb-6">Contact the flight operations desk if you encounter any issues with scheduling or pricing.</p>
                <button class="w-full py-3 bg-white border border-outline rounded-xl text-sm font-bold text-primary hover:bg-primary hover:text-on-primary hover:border-primary transition-all">
                    Contact Ops
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
