@model FlightReservationSystem.Models.Flight

@{
    ViewData["Title"] = "Flight Details";
}

<div class="bg-slate-50 min-h-screen py-12 px-8">
    <div class="max-w-[800px] mx-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-4">
                <a asp-action="Index" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <h1 class="text-2xl font-bold text-slate-900">Flight Details</h1>
            </div>
            <div class="flex gap-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 bg-white border border-slate-200 text-slate-600 font-bold rounded-lg hover:bg-slate-50 transition-all text-sm">
                    Edit Record
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="px-4 py-2 bg-rose-50 text-rose-600 font-bold rounded-lg hover:bg-rose-600 hover:text-white transition-all text-sm">
                    Delete
                </a>
            </div>
        </div>

        <!-- Info Card -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="p-8 border-b border-slate-100">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Flight Number</p>
                        <p class="text-4xl font-black text-slate-900">@Model.FlightNumber</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Standard Fare</p>
                        <p class="text-3xl font-black text-primary">$@Model.Price.ToString("N2")</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="bg-slate-50 p-6 rounded-xl border border-slate-100">
                        <p class="text-[10px] font-bold text-slate-400 uppercase mb-2">Origin</p>
                        <p class="text-xl font-bold text-slate-900">@Model.FromCity</p>
                    </div>
                    <div class="bg-slate-50 p-6 rounded-xl border border-slate-100">
                        <p class="text-[10px] font-bold text-slate-400 uppercase mb-2">Destination</p>
                        <p class="text-xl font-bold text-slate-900">@Model.ToCity</p>
                    </div>
                </div>
            </div>

            <div class="p-8 bg-slate-50/50">
                <h3 class="text-sm font-bold text-slate-900 mb-4">Quick Stats</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                    <div>
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Operational Status</p>
                        <p class="text-sm font-bold text-emerald-600">Active</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Total Bookings</p>
                        <p class="text-sm font-bold text-slate-900">124</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Last Updated</p>
                        <p class="text-sm font-bold text-slate-900">Today</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
