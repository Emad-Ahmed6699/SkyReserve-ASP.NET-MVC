@model FlightReservationSystem.Models.Flight

@{
    ViewData["Title"] = "Flight Details";
}

<div class="max-w-[1280px] mx-auto px-8 py-12">
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
            <a asp-action="Index" class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container text-primary hover:bg-primary hover:text-on-primary transition-all shadow-sm">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Flight Details</h1>
        </div>
        <div class="flex gap-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-primary-container text-on-primary px-6 py-3 rounded-xl font-headline-md flex items-center gap-2 hover:bg-primary transition-all active:scale-95 shadow-md">
                <span class="material-symbols-outlined">edit</span> Edit Flight
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="border border-error text-error px-6 py-3 rounded-xl font-headline-md bg-white hover:bg-error hover:text-white transition-all active:scale-95">
                Delete
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Detail Card -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="bg-primary/5 p-8 border-b border-slate-100 flex justify-between items-center">
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-primary shadow-sm">
                            <span class="material-symbols-outlined !text-3xl">flight</span>
                        </div>
                        <div>
                            <span class="text-xs font-bold text-primary uppercase tracking-widest">SkyReserve Airlines</span>
                            <h2 class="text-2xl font-bold text-on-surface">@Model.FlightNumber</h2>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-3xl font-bold text-primary">$@Model.Price</div>
                        <span class="text-xs text-on-surface-variant font-medium">Standard Economy Price</span>
                    </div>
                </div>
                
                <div class="p-8">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-center relative">
                        <!-- Origin -->
                        <div class="text-center md:text-left">
                            <div class="text-4xl font-black text-on-surface mb-2 uppercase">@Model.FromCity.Substring(0, Math.Min(3, Model.FromCity.Length))</div>
                            <div class="text-on-surface-variant font-medium">@Model.FromCity</div>
                            <div class="mt-4 flex items-center justify-center md:justify-start gap-2 text-primary font-bold">
                                <span class="material-symbols-outlined">flight_takeoff</span>
                                <span>Departure</span>
                            </div>
                        </div>

                        <!-- Path Decorator -->
                        <div class="hidden md:flex flex-col items-center justify-center">
                            <div class="w-full h-[2px] bg-slate-200 relative">
                                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 bg-white border border-slate-200 rounded-full flex items-center justify-center text-primary shadow-sm">
                                    <span class="material-symbols-outlined !text-lg">flight</span>
                                </div>
                            </div>
                            <span class="mt-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Non-Stop</span>
                        </div>

                        <!-- Destination -->
                        <div class="text-center md:text-right">
                            <div class="text-4xl font-black text-on-surface mb-2 uppercase">@Model.ToCity.Substring(0, Math.Min(3, Model.ToCity.Length))</div>
                            <div class="text-on-surface-variant font-medium">@Model.ToCity</div>
                            <div class="mt-4 flex items-center justify-center md:justify-end gap-2 text-primary font-bold">
                                <span>Arrival</span>
                                <span class="material-symbols-outlined">flight_land</span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-10 border-slate-100" />

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Duration</div>
                            <div class="font-bold text-on-surface">3h 45m</div>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Aircraft</div>
                            <div class="font-bold text-on-surface">Airbus A320neo</div>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Terminal</div>
                            <div class="font-bold text-on-surface">T3, Gate 42</div>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Status</div>
                            <div class="inline-flex bg-green-100 text-green-700 px-2 py-1 rounded-md text-xs font-bold uppercase">Scheduled</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Actions/Stats -->
        <div class="space-y-6">
            <div class="bg-surface-container p-8 rounded-3xl border border-slate-200">
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6">Booking Overview</h3>
                <div class="space-y-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-primary shadow-sm">
                            <span class="material-symbols-outlined">group</span>
                        </div>
                        <div>
                            <div class="text-xl font-bold text-on-surface">45 / 150</div>
                            <div class="text-xs text-on-surface-variant uppercase font-bold tracking-widest">Seats Occupied</div>
                        </div>
                    </div>
                    <div class="w-full bg-white h-2 rounded-full overflow-hidden shadow-inner">
                        <div class="bg-primary h-full" style="width: 30%"></div>
                    </div>
                    <div class="pt-4 flex justify-between items-center">
                        <span class="text-sm font-medium text-on-surface-variant">Revenue Generated</span>
                        <span class="text-lg font-bold text-primary">$55,800</span>
                    </div>
                </div>
            </div>

            <button class="w-full py-4 bg-primary text-on-primary rounded-2xl font-bold shadow-lg hover:bg-primary/90 transition-all flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">add_circle</span> Book Passenger
            </button>
        </div>
    </div>
</div>
