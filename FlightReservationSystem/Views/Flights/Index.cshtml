@model IEnumerable<FlightReservationSystem.Models.Flight>

@{
    ViewData["Title"] = "Available Flights";
}

<div class="container py-5 mt-5">
    <div class="d-flex justify-content-between align-items-end mb-5" data-aos="fade-down">
        <div>
            <h1 class="display-4 fw-bold">Available Flights</h1>
            <p class="text-muted">Find the best deals for your next adventure.</p>
        </div>
        <a asp-action="Create" class="btn btn-premium px-4">
            <i class="fa-solid fa-plus me-2"></i>Add New Flight
        </a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model) {
            <div class="col-lg-12" data-aos="fade-up">
                <div class="glass-card d-flex flex-wrap align-items-center justify-content-between gap-4">
                    <div class="d-flex align-items-center gap-4">
                        <div class="bg-primary bg-opacity-10 p-4 rounded-4 text-primary">
                            <i class="fa-solid fa-plane-departure fs-2"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 text-white">#@item.FlightNumber</h4>
                            <span class="badge bg-primary bg-opacity-25 text-primary rounded-pill mt-1">Premium Economy</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-5 flex-grow-1 justify-content-center px-4">
                        <div class="text-center">
                            <h5 class="mb-0 text-white">@item.FromCity</h5>
                            <small class="text-muted">Departure</small>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div style="height: 1px; width: 50px; background: var(--glass-border);"></div>
                            <i class="fa-solid fa-plane text-primary"></i>
                            <div style="height: 1px; width: 50px; background: var(--glass-border);"></div>
                        </div>
                        <div class="text-center">
                            <h5 class="mb-0 text-white">@item.ToCity</h5>
                            <small class="text-muted">Arrival</small>
                        </div>
                    </div>

                    <div class="text-end">
                        <h3 class="text-primary mb-0">$@item.Price</h3>
                        <p class="text-muted small mb-3">per person</p>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light border-opacity-25"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light border-opacity-25"><i class="fa-solid fa-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-opacity-25"><i class="fa-solid fa-trash"></i></a>
                            <a href="#" class="btn btn-premium btn-sm px-4">Book</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
